# ==============================================================================
# Dockerfile для MLOps-сервиса предсказания цен на автомобили
# ==============================================================================

# 1. Базовый образ: python:3.10-slim
# Образ slim содержит минимальный набор пакетов Debian, что уменьшает размер
# итогового Docker-образа и снижает количество уязвимостей (security best practice).
FROM python:3.10-slim

# Отключаем буферизацию вывода Python и создание .pyc файлов:
# - PYTHONUNBUFFERED=1: логи приложения сразу попадают в stdout/stderr контейнера
# - PYTHONDONTWRITEBYTECODE=1: предотвращает запись байткода на диск
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# 2. Рабочая директория внутри контейнера
WORKDIR /app

# 3. Кэширование слоев зависимостей
# Сначала копируем только requirements.txt и ставим библиотеки.
# Если код в app.py или train.py изменится, Docker не будет заново скачивать
# и компилировать тяжелые библиотеки (scikit-learn, pandas), а использует кэш.
COPY requirements.txt .

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 4. Копируем исходный код проекта
COPY . .

# 5. Обучение модели на этапе сборки образа (Build-time training)
# В результате выполнения этой команды создается файл model.pkl прямо внутри образа.
RUN python train.py

# 6. Документируем порт, на котором слушает сервис
EXPOSE 8000

# 7. Команда запуска веб-сервера Uvicorn
# --host 0.0.0.0: обязательно для Docker, чтобы сервер принимал подключения извне контейнера
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]

